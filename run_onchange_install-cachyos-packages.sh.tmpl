#!/usr/bin/env bash
# vim: ft=sh

set -euo pipefail

# Package list: .chezmoidata/packages.yaml (cli + desktop).

{{ if and (eq .chezmoi.os "linux") (hasKey .chezmoi.osRelease "id") (eq .chezmoi.osRelease.id "cachyos") -}}

packages=(
{{- range (concat .packages.cli .packages.desktop) }}
{{-   if kindIs "string" . }}
  {{ . }}
{{-   else if hasKey . "arch" }}
  {{ .arch }}
{{-   end }}
{{- end }}
)

sudo -v

sudo pacman -Syu --needed --noconfirm paru

paru -S --needed --noconfirm --sudoloop "${packages[@]}"

sudo systemctl enable --now docker.service
if ! id -nG "$USER" | grep -qw docker; then
  sudo usermod -aG docker "$USER"
  echo "Added $USER to the docker group.  Log out and back in to apply."
fi

{{ else -}}
echo "install-cachyos-packages: not a CachyOS system, skipping." >&2
{{- end }}
