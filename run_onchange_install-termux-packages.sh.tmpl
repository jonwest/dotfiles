{{- if (eq .chezmoi.os "android") -}}
#!/usr/bin/env bash
set -euo pipefail

# Package list: .chezmoidata/packages.yaml (cli only).
packages=(
{{- range .packages.cli }}
{{-   if kindIs "string" . }}
  {{ . }}
{{-   else if hasKey . "termux" }}
  {{ .termux }}
{{-   end }}
{{- end }}
)

pkg upgrade -y
pkg install -y "${packages[@]}"

{{- end }}
